# ============================================================
# 影刀 RPA 控制台 — 配置模板
# 复制本文件为 .env 后按需修改（.env 已被 .gitignore 排除，不会提交）
#
# 说明：影刀安装目录/CLI/录屏目录已支持「自动探测」，
#       以下路径类配置默认留空即可，绝大多数电脑无需任何配置。
#       仅当影刀装在非常规位置、自动探测不准确时，才取消注释并手动填写。
# ============================================================

# HTTP 服务端口
PORT=18923

# 监听地址：0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机
HOST=0.0.0.0

# 影刀 CLI 可执行文件名（默认自动探测并解析为安装目录下的绝对路径）
# CLI_EXE=shadowbot.shell-cli.exe

# 影刀 CLI 工作目录（默认自动探测影刀安装目录）
# CLI_CWD=D:\ShadowBot

# 视频回放目录（默认自动探测为「安装目录\screencast」，录屏开启后如需改路径再配置）
# SCREENCAST_DIR=D:\ShadowBot\screencast

# 备份文件存储目录（默认为项目下 backups/，可改为绝对路径）
# BACKUP_DIR=

# 影刀本地 REST API（通常无需修改，仅本机 127.0.0.1:42500）
# REST_HOST=127.0.0.1
# REST_PORT=42500

# 缓存 TTL（毫秒）
# CACHE_TTL=30000
# REST_CACHE_TTL=30000
