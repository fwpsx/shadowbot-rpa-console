# ============================================================
# 影刀 RPA 控制台 — 配置模板
# 复制本文件为 .env 后按需修改（.env 已被 .gitignore 排除，不会提交）
# 所有配置均有默认值，不设置也能直接运行。
# ============================================================

# HTTP 服务端口
PORT=18923

# 监听地址：0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机
HOST=0.0.0.0

# 影刀 CLI 可执行文件名（默认随客户端附带，已在 PATH 中）
CLI_EXE=shadowbot.shell-cli.exe

# 影刀 CLI 工作目录（影刀安装目录，按需修改）
CLI_CWD=D:\ShadowBot

# 视频回放目录（影刀录屏目录，按需修改）
SCREENCAST_DIR=D:\ShadowBot\screencast

# 备份文件存储目录（默认为项目下 backups/，可改为绝对路径）
# BACKUP_DIR=

# 影刀本地 REST API（通常无需修改，仅本机 127.0.0.1:42500）
# REST_HOST=127.0.0.1
# REST_PORT=42500

# 缓存 TTL（毫秒）
# CACHE_TTL=30000
# REST_CACHE_TTL=30000
